    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wpflow.Wpf</RootNamespace>
    <PackageId>Wpflow.Wpf</PackageId>
