<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Le BCL des anciennes cibles n'est pas annoté : la nullabilité est vérifiée par le build .NET 8. -->
    <Nullable Condition="!$(TargetFramework.StartsWith('net8.0'))">annotations</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wpflow.Wpf</RootNamespace>
    <PackageId>Wpflow.Wpf</PackageId>
    <Description>Contrôles WPF de Wpflow : FlowView, nodes, handles, edges, MiniMap, Controls, NodeResizer, NodeToolbar.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpflow.Core\Wpflow.Core.csproj" />
    <!-- Logique commune aux deux vues, internal : voir le fichier. -->
    <Compile Include="..\Wpflow.Core\Interaction\Shared\*.cs" LinkBase="Shared" />
    <!-- API récentes absentes de net472 (rien n'est compilé en .NET 8). -->
    <Compile Include="..\Wpflow.Core\Polyfills\*.cs" LinkBase="Polyfills" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wpflow.Wpf.Tests" />
    <InternalsVisibleTo Include="demo" />
    <InternalsVisibleTo Include="Scenarios.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
