<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wpflow.Blazor</RootNamespace>
    <PackageId>Wpflow.Blazor</PackageId>
    <Description>Éditeur de graphes node/edge interactif pour Blazor au-dessus de Wpflow.Core.</Description>
    <PackageTags>blazor;diagram;graph;node-editor;flow;xyflow;reactflow</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="../Wpflow.Core/Wpflow.Core.csproj" />
    <!-- Logique commune aux deux vues, internal : voir le fichier. -->
    <Compile Include="../Wpflow.Core/Interaction/Shared/*.cs" LinkBase="Shared" />
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
