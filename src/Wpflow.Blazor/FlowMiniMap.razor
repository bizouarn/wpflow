@namespace Wpflow.Blazor
@implements IDisposable

@if (Flow != null)
{
    var m = Flow.MiniMapView(Width, Height);
    var view = m.View;
    var scale = view.Width / Width;
    <div class="wf-panel wf-minimap wf-panel-@(PanelPosition.ToString().ToLowerInvariant()) nopan nodrag nowheel @Class" style="width:@(Width)px;height:@(Height)px" data-wf-wheel="@(Zoomable ? "zoom" : null)">
        <svg @ref="_svg" width="@Width" height="@Height" viewBox="@FlowView.F(view.X) @FlowView.F(view.Y) @FlowView.F(view.Width) @FlowView.F(view.Height)"
             @onpointerdown="e => Down(e, view)" @onpointerdown:stopPropagation
             @onpointermove="DragHandler(view)" @onpointerup="Up" @onpointerleave="Up"
             @onwheel="e => Wheel(e)" @onwheel:stopPropagation>
            @* Les rectangles sont en coordonnées flow : un pan ne change que le cadre et le voile. *@
            <FlowLayer Revision="NodesRevision(scale)">
                @foreach (var (node, r) in Flow.MiniMapNodes())
                {
                    var n = node;
                    var fill = NodeColor?.Invoke(n) ?? (n.Selected ? "var(--wf-minimap-node-selected)" : "var(--wf-minimap-node)");
                    var stroke = NodeStrokeColor?.Invoke(n);
                    <rect @key="n.Id" class="wf-minimap-node" x="@FlowView.F(r.X)" y="@FlowView.F(r.Y)" width="@FlowView.F(r.Width)" height="@FlowView.F(r.Height)"
                          rx="@FlowView.F(NodeBorderRadius * scale)" fill="@fill" stroke="@stroke" stroke-width="@(stroke == null ? null : FlowView.F(NodeStrokeWidth * scale))"
                          @onpointerdown="PressHandler(n)" />
                }
            </FlowLayer>
            <path fill-rule="evenodd" fill="@(MaskColor ?? "var(--wf-minimap-mask)")" pointer-events="none"
                  d="M@(FlowView.F(view.X)) @(FlowView.F(view.Y))h@(FlowView.F(view.Width))v@(FlowView.F(view.Height))h@(FlowView.F(-view.Width))z M@(FlowView.F(m.Visible.X)) @(FlowView.F(m.Visible.Y))h@(FlowView.F(m.Visible.Width))v@(FlowView.F(m.Visible.Height))h@(FlowView.F(-m.Visible.Width))z" />
        </svg>
    </div>
}

@code {
    private ElementReference _svg;
    private XYPosition _origin;
    private bool _down;

    [CascadingParameter] private FlowView? Flow { get; set; }

    [Parameter] public int Width { get; set; } = 200;
    [Parameter] public int Height { get; set; } = 150;
    [Parameter] public PanelPosition PanelPosition { get; set; } = PanelPosition.BottomRight;

    /// <summary>Couleur d'un node (<c>nodeColor</c>) ; <c>null</c> = thème.</summary>
    [Parameter] public Func<Node, string?>? NodeColor { get; set; }

    [Parameter] public Func<Node, string?>? NodeStrokeColor { get; set; }
    [Parameter] public double NodeStrokeWidth { get; set; } = 2;
    [Parameter] public double NodeBorderRadius { get; set; } = 3;

    /// <summary>Voile hors de la vue ; <c>null</c> = thème.</summary>
    [Parameter] public string? MaskColor { get; set; }

    /// <summary>Glisser dans la minimap recentre la vue (<c>pannable</c>).</summary>
    [Parameter] public bool Pannable { get; set; } = true;

    /// <summary>La molette sur la minimap zoome (<c>zoomable</c>).</summary>
    [Parameter] public bool Zoomable { get; set; }

    [Parameter] public bool InversePan { get; set; }
    [Parameter] public double ZoomStep { get; set; } = 10;

    /// <summary>Clic sur un node de la minimap (<c>onNodeClick</c>).</summary>
    [Parameter] public EventCallback<Node> OnNodeClick { get; set; }

    [Parameter] public string? Class { get; set; }

    private IDisposable? _following;

    protected override void OnInitialized() => _following = Flow?.Follow(() => _ = InvokeAsync(StateHasChanged));

    private (int Nodes, int Scale, object?, object?, double, double, bool) _drawn;
    private int _revision;

    // Change quand les rectangles sont à refaire : les nodes ont changé, ou un réglage d'ici. Ni un mouvement de vue ni la
    // virtualisation ne les concernent. L'échelle, qui ne fixe que les arrondis et les traits, compte par paliers d'environ 10 %.
    private int NodesRevision(double scale)
    {
        var state = (Flow!.NodesVersion, (int)Math.Round(Math.Log(Math.Max(scale, 1e-6)) * 10), (object?)NodeColor,
            (object?)NodeStrokeColor, NodeStrokeWidth, NodeBorderRadius, OnNodeClick.HasDelegate);
        if (!state.Equals(_drawn))
        {
            _drawn = state;
            _revision++;
        }

        return _revision;
    }

    public void Dispose() => _following?.Dispose();

    // Les coordonnées d'un clic sont relatives à l'élément cible : on les ramène à la minimap grâce à son origine mesurée.
    private XYPosition ToFlow(PointerEventArgs e, Rect view)
    {
        var d = Flow!.Unscale(e.ClientX - _origin.X, e.ClientY - _origin.Y);
        return new(view.X + d.X / Width * view.Width, view.Y + d.Y / Height * view.Height);
    }

    private async Task Down(PointerEventArgs e, Rect view)
    {
        if (Flow == null || !Pannable) return;
        _origin = await Flow.ElementOrigin(_svg);
        _down = true;
        await Flow.CenterOn(ToFlow(e, view));
    }

    private EventCallback<PointerEventArgs> DragHandler(Rect view) => _down && Flow != null
        ? EventCallback.Factory.Create<PointerEventArgs>(this, e => Flow.CenterOn(ToFlow(e, view)))
        : default;

    private void Up() => _down = false;

    // Sans écoute, aucun gestionnaire : chaque dessin en renouvellerait un par rectangle dans le navigateur.
    private EventCallback<PointerEventArgs> PressHandler(Node n) =>
        OnNodeClick.HasDelegate ? EventCallback.Factory.Create<PointerEventArgs>(this, e => NodeDown(n, e)) : default;

    private async Task NodeDown(Node n, PointerEventArgs e)
    {
        if (OnNodeClick.HasDelegate) await OnNodeClick.InvokeAsync(n);
    }

    private async Task Wheel(WheelEventArgs e)
    {
        if (!Zoomable || Flow == null) return;
        var pixels = e.DeltaY * (e.DeltaMode == 1 ? 20 : 1); // lignes -> pixels, comme sur la surface
        await Flow.ZoomBy(ViewLogic.MiniMapZoomFactor(pixels, ZoomStep));
    }
}
