<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Hôte Blazor WebAssembly de la démo : tout s'exécute dans le navigateur, sans aller-retour réseau par geste. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DemoBlazorWasm</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../blazor-shared/demo-blazor-shared.csproj" />
  </ItemGroup>

</Project>
