@using Wpflow.Blazor
@using Wpflow.Core

<div class="ex">
    <div class="ex-toolbar">
        <button @onclick="Export">Exporter en JSON</button>
        <button @onclick="Import" disabled="@(_json.Length == 0)">Recharger depuis le texte</button>
        <button @onclick="@(() => _flow!.SaveImage("graphe.png"))">Télécharger en PNG</button>
        <span role="status">@_message</span>
    </div>
    <div class="ex-split">
        <div class="ex-flow">
            <FlowView @ref="_flow" @bind-Nodes="_nodes" @bind-Edges="_edges">
                <FlowControls />
            </FlowView>
        </div>
        <textarea class="ex-text" aria-label="Graphe au format JSON" spellcheck="false" @bind="_json" @bind:event="oninput"
                  placeholder="Exportez, modifiez un label ou une position, puis rechargez."></textarea>
    </div>
</div>

@code {
    private FlowView? _flow;
    private string _json = "";
    private string? _message;

    private IReadOnlyList<Node> _nodes =
    [
        new Node("1", new XYPosition(0, 0), "input", "Commande"),
        new Node("2", new XYPosition(40, 130), "output", "Livraison")
    ];

    private IReadOnlyList<Edge> _edges = [new Edge("1-2", "1", "2", Label: "48 h", MarkerEnd: EdgeMarker.ArrowClosed)];

    // La forme { nodes, edges, viewport } est celle de React Flow.
    private void Export() => (_json, _message) = (_flow!.ToJson(), "Exporté.");

    private async Task Import()
    {
        try
        {
            await _flow!.LoadJson(_json);
            _message = "Rechargé.";
        }
        catch (Exception error) when (error is System.Text.Json.JsonException or InvalidOperationException
                                          or KeyNotFoundException or FormatException)
        {
            _message = "JSON refusé : " + error.Message;
        }
    }
}
