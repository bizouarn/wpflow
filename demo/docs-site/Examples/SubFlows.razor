@using Wpflow.Blazor
@using Wpflow.Core

<div class="ex-flow">
    <FlowView @bind-Nodes="_nodes" @bind-Edges="_edges">
        <FlowMiniMap />
        <FlowControls />
    </FlowView>
</div>

@code {
    // The position of a child is relative to its parent; ExtentParent keeps it inside.
    // Deleting the group also deletes its children.
    private IReadOnlyList<Node> _nodes =
    [
        new Node("groupe", new XYPosition(0, 0), "group", "Group", FixedWidth: 360, FixedHeight: 240),
        new Node("a", new XYPosition(30, 50), "input", "Child A", ParentId: "groupe", ExtentParent: true),
        new Node("b", new XYPosition(170, 160), "default", "Child B", ParentId: "groupe", ExtentParent: true),
        new Node("dehors", new XYPosition(460, 90), "output", "Outside the group", TargetPosition: Position.Left)
    ];

    private IReadOnlyList<Edge> _edges =
    [
        new Edge("a-b", "a", "b"),
        new Edge("b-dehors", "b", "dehors", Animated: true)
    ];
}
