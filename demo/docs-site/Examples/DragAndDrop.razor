@using Wpflow.Blazor
@using Wpflow.Core

<div class="ex-split">
    <div class="ex-palette" aria-label="Palette">
        <p>Drag onto the graph:</p>
        @foreach (var (type, label) in Items)
        {
            @* "ondragstart" in JavaScript: Firefox only starts a drag if data is set. *@
            <div class="ex-chip" draggable="true" ondragstart="event.dataTransfer.setData('text/plain', 'node')"
                 @onpointerdown="() => _dragged = type">@label</div>
        }
    </div>
    <div class="ex-flow">
        <FlowView @ref="_flow" @bind-Nodes="_nodes" @bind-Edges="_edges" OnDrop="OnDrop" FitViewOnInit="false">
            <FlowControls />
        </FlowView>
    </div>
</div>

@code {
    private static readonly (string Type, string Label)[] Items =
        [("input", "Input node"), ("default", "Default node"), ("output", "Output node")];

    private FlowView? _flow;
    private string? _dragged;
    private int _next = 1;

    private IReadOnlyList<Node> _nodes = [new Node("depart", new XYPosition(60, 40), "input", "Start")];
    private IReadOnlyList<Edge> _edges = [];

    private async Task OnDrop(FlowDropEventArgs e)
    {
        if (_dragged is not { } type) return;
        _dragged = null;
        // e.Position is already in graph coordinates, whatever the zoom and scrolling.
        await _flow!.AddNodes([new Node($"n{_next}", e.Position, type, $"Node {_next++}")]);
    }
}
