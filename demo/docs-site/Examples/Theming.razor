@using Wpflow.Blazor
@using Wpflow.Core

<div class="ex">
    <div class="ex-toolbar">
        <label>
            Theme
            <select @bind="_theme">
                <option value="clair">Light (default)</option>
                <option value="sombre">Dark</option>
                <option value="ambre">Amber (CSS variables)</option>
            </select>
        </label>
        <label>
            Background
            <select @bind="_variant">
                <option value="@BackgroundVariant.Dots">Dots</option>
                <option value="@BackgroundVariant.Lines">Lines</option>
                <option value="@BackgroundVariant.Cross">Cross</option>
            </select>
        </label>
    </div>
    <div class="ex-flow">
        @* The class "lib-theme" tells this site not to apply its own colours to the graph.
           "theme-ambre" redefines the --wf-* variables (see below). *@
        <FlowView @bind-Nodes="_nodes" @bind-Edges="_edges" Dark="@(_theme == "sombre")" BackgroundVariant="_variant"
                  Class="@($"lib-theme theme-{_theme}")">
            <FlowMiniMap />
            <FlowControls />
        </FlowView>
    </div>
</div>

<style>
    .wf-flow.theme-ambre {
        --wf-bg: #1d1608; --wf-dot: #6b5320; --wf-node-bg: #2d220c; --wf-node-text: #ffe9b8;
        --wf-node-border: #b88a2a; --wf-node-selected: #ffd36b; --wf-edge: #ffb627; --wf-handle: #ffd36b;
        --wf-handle-bg: #1d1608; --wf-panel-bg: #2d220c; --wf-panel-border: #5a4418;
        --wf-minimap-bg: #2d220c; --wf-minimap-node: #8a6a22; --wf-minimap-mask: rgba(20, 14, 4, .6);
    }
</style>

@code {
    private string _theme = "ambre";
    private BackgroundVariant _variant = BackgroundVariant.Dots;

    private IReadOnlyList<Node> _nodes =
    [
        new Node("1", new XYPosition(0, 0), "input", "Sensor"),
        new Node("2", new XYPosition(180, 100), "default", "Average"),
        new Node("3", new XYPosition(40, 220), "output", "Alert")
    ];

    private IReadOnlyList<Edge> _edges =
    [
        new Edge("1-2", "1", "2", Animated: true),
        new Edge("2-3", "2", "3", MarkerEnd: EdgeMarker.ArrowClosed)
    ];
}
