@using Wpflow.Blazor
@using Wpflow.Core

<div class="ex">
    <div class="ex-toolbar">
        <button @onclick="() => Arrange(LayoutDirection.TopToBottom)">Ranger de haut en bas</button>
        <button @onclick="() => Arrange(LayoutDirection.LeftToRight)">Ranger de gauche à droite</button>
        <button @onclick="Shuffle">Mélanger</button>
    </div>
    <div class="ex-flow">
        <FlowView @ref="_flow" @bind-Nodes="_nodes" @bind-Edges="_edges" MinZoom="0.2">
            <FlowControls />
        </FlowView>
    </div>
</div>

@code {
    private FlowView? _flow;
    private readonly Random _random = new(4);

    private IReadOnlyList<Node> _nodes = new[] { "Sources", "Lecture", "Filtre", "Jointure", "Calcul", "Rapport", "Export" }
        .Select((name, i) => new Node($"{i}", new XYPosition(i * 137 % 520, i * 211 % 300), Data: name)).ToList();

    private IReadOnlyList<Edge> _edges = new[] { (0, 1), (0, 2), (1, 3), (2, 3), (3, 4), (4, 5), (4, 6) }
        .Select(l => new Edge($"{l.Item1}-{l.Item2}", $"{l.Item1}", $"{l.Item2}")).ToList();

    private async Task Arrange(LayoutDirection direction)
    {
        var positions = GraphLayout.Layered(_nodes, _edges, direction);

        // Les handles suivent le sens du rangement.
        var horizontal = direction == LayoutDirection.LeftToRight;
        _nodes = _nodes.Select(n => n with
        {
            SourcePosition = horizontal ? Position.Right : Position.Bottom,
            TargetPosition = horizontal ? Position.Left : Position.Top
        }).ToList();

        await _flow!.ApplyNodeChanges(positions.Select(p => (NodeChange)new NodePositionChange(p.Key, p.Value)).ToList());
        await Fit();
    }

    private async Task Shuffle()
    {
        await _flow!.ApplyNodeChanges(_nodes.Select(n => (NodeChange)new NodePositionChange(n.Id,
            new XYPosition(_random.Next(0, 600), _random.Next(0, 340)))).ToList());
        await Fit();
    }

    private Task Fit() => _flow!.FitView(new FitViewOptions(Duration: TimeSpan.FromMilliseconds(300)));
}
