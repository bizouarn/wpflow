@inject IJSRuntime Js

@* L'anneau de solides du rendu, comme CubeField dans la démo WPF ; dessiné et animé par ring.js. *@
<canvas @ref="_canvas" class="ring" role="img"
        aria-label="@($"Anneau de {(Pyramids ? "pyramides" : "cubes")}")"></canvas>

@code {
    private static readonly double[][] Solids = CreateSolids();

    private ElementReference _canvas;

    [Parameter, EditorRequired] public string Color { get; set; } = "";
    [Parameter] public bool Pyramids { get; set; }
    [Parameter] public int Zoom { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await Js.InvokeVoidAsync("wpsite.ring", _canvas, Solids, Color, Pyramids, Zoom / 100d);

    // Même graine et même tirage que la démo WPF : les solides sont identiques.
    private static double[][] CreateSolids()
    {
        var rng = new Random(11);
        return Enumerable.Range(0, 72).Select(_ =>
        {
            // Point d'une boule de rayon 1 : l'écart du solide autour du cercle porteur.
            double x, y, z;
            do
            {
                x = rng.NextDouble() * 2 - 1;
                y = rng.NextDouble() * 2 - 1;
                z = rng.NextDouble() * 2 - 1;
            } while (x * x + y * y + z * z > 1);

            return new[] { x, y, z, rng.NextDouble() * Math.PI * 2, 0.4 + rng.NextDouble() * 0.9, 0.07 + rng.NextDouble() * 0.06 };
        }).ToArray();
    }
}
