@inject IJSRuntime Js

@* A running example, its code (the compiled file) and a button to start again from scratch. *@
@if (_example == null)
{
    <div class="note"><p>Unknown example: <code>@Id</code>.</p></div>
}
else
{
    <section class="example" data-example="@_example.Id" aria-label="@($"Example: {_example.Title}")">
        <div class="example-bar">
            <div class="example-tabs" role="tablist">
                <button role="tab" aria-selected="@(_code ? "false" : "true")" @onclick="() => _code = false">Preview</button>
                <button role="tab" aria-selected="@(_code ? "true" : "false")" @onclick="() => _code = true">Code</button>
            </div>
            <span class="example-title">@_example.Title <em>Blazor</em></span>
            <button class="example-reset" @onclick="() => _run++">Reset</button>
            @if (Compact)
            {
                <a class="example-open" href="@($"exemples/{_example.Id}")">Open full size →</a>
            }
        </div>
        @* Hidden rather than removed: looking at the code does not lose the state of the graph. *@
        <div class="example-stage @(Compact ? "compact" : "")" hidden="@_code">
            <DynamicComponent @key="@($"{_example.Id}:{_run}")" Type="_example.Component" />
        </div>
        @if (_code)
        {
            <pre class="example-code"><code class="language-xml">@_example.Source</code></pre>
        }
    </section>
}

@code {
    private Example? _example;
    private bool _code;
    private int _run;

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Set when the example is embedded in a documentation page.</summary>
    [Parameter] public bool Compact { get; set; }

    protected override void OnParametersSet()
    {
        if (_example?.Id == Id) return;
        _example = ExampleCatalog.Find(Id);
        _code = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await Js.InvokeVoidAsync("wpsite.enhanceCode");
}
