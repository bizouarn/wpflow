@* The documentation comes from the repository, where much of it describes WPF: say so at the top of the page. *@
@if (Page.File != "doc/blazor.md")
{
    var related = ExampleCatalog.ForDoc(Page.File);
    <div class="note" role="note">
        @if (SharedPages.Contains(Page.File))
        {
            <p><strong>Shared core.</strong> <code>Wpflow.Core</code> is used by WPF and Blazor alike: the types and functions described here apply to both.</p>
        }
        else
        {
            <p>
                <strong>Page written first for the WPF version.</strong> WPF does not run in a browser: the interactive
                examples on this site are in <strong>Blazor</strong>. The concepts are the same; for names specific to
                Blazor, see <a href="doc/blazor">Wpflow.Blazor</a>.
            </p>
        }
        @if (related.Count > 0)
        {
            <p class="note-links">
                <span>Try it in Blazor:</span>
                @foreach (var example in related)
                {
                    <a class="chip" href="@($"exemples/{example.Id}")">@example.Title</a>
                }
            </p>
        }
    </div>
}

@code {
    private static readonly string[] SharedPages =
        ["doc/reference/types.md", "doc/reference/changes.md", "doc/reference/utils.md"];

    [Parameter, EditorRequired] public DocPage Page { get; set; } = default!;
}
