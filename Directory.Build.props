<Project>
  <PropertyGroup>
    <!-- Remplacée par la version du tag (v1.2.3) dans le workflow de release. -->
    <Version>1.1.0</Version>
    <!-- Validation de paquet : au « dotnet pack », une API retirée par rapport à la version de référence (publiée sur
         nuget.org) fait échouer la construction. À avancer après chaque publication. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
    <Authors>bizouarn</Authors>
    <Copyright>Copyright (c) bizouarn</Copyright>
    <Product>Wpflow</Product>
    <Description>Éditeur de graphes node/edge interactif pour WPF, porté de xyflow (React Flow).</Description>
    <PackageTags>wpf;diagram;graph;node-editor;flow;xyflow;reactflow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Icône de nuget.org, commune aux trois paquets : rendue en 256 × 256 depuis assets/logo.svg. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bizouarn/wpflow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bizouarn/wpflow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
