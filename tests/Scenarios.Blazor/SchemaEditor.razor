@implements IDisposable
@inject NavigationManager Navigation

<div class="bar">
    <button id="load-library" @onclick="() => Open(Schemas.Library())">autre schéma</button>
    <button id="load-large" @onclick="() => Open(Schemas.Large())">200 tables</button>
    <button id="load-wide" @onclick="() => Open(Schemas.Wide())">table large</button>
    <label><input id="virtualize" type="checkbox" @bind="_virtualize" /> virtualisation</label>
    <button id="add-column" @onclick='() => Store.AddColumn("customers", new Column("added", "int"), 1)'>ajouter une colonne</button>
    <button id="remove-column" @onclick='() => Store.RemoveColumn("customers", "name")'>retirer « name »</button>
    <button id="move-column" @onclick='() => Store.MoveColumn("customers", "id", 2)'>descendre « id »</button>
    <button id="collapse" @onclick='() => Store.ToggleCollapsed("customers")'>replier « customers »</button>
    <button id="fit" @onclick="async () => await _flow!.FitView()">cadrer</button>
    <button id="undo" @onclick="async () => await _flow!.Undo()">annuler</button>
    <button id="save" @onclick="Save">enregistrer</button>
    <button id="restore" @onclick="Restore">relire</button>
    <button id="clear-events" @onclick="() => _events.Clear()">vider le journal</button>
    <button id="ticks" @onclick="ToggleTicks">@(_timer == null ? "mises à jour de fond" : "arrêter les mises à jour")</button>
</div>
<div class="status">
    <span id="log">@_log</span> |
    <span id="menu">@_menu</span> |
    <span id="selection-menu">@_selectionMenu</span> |
    <span id="events">@string.Join(" > ", _events)</span> |
    <span id="refused">@string.Join(", ", Store.Refused)</span> |
    <span id="count">@Store.Nodes.Count tables, @Store.Edges.Count relations</span>
</div>

<div class="graph">
    <FlowView @ref="_flow" @attributes="DataParameters()" EdgeTypes="_edgeTypes" NodeTemplates="_nodeTemplates"
              EdgeLabelTemplate="Label" OnlyRenderVisibleElements="_virtualize" FitViewOnInit="true" MinZoom="0.05"
              OnNodeClick='a => Note(_log = "clic " + Describe(a))' OnNodeDoubleClick='a => Note(_log = "double-clic " + Describe(a))'
              OnNodeContextMenu='a => Note(_menu = (a.TargetData.ContainsKey("column") ? "colonne " : "table ") + Describe(a))'
              OnEdgeContextMenu='a => _menu = "relation " + a.Edge.Id'
              OnPaneContextMenu='_ => _menu = "fond"'
              OnSelectionContextMenu='_ => Note(_selectionMenu = "sélection de " + Store.Nodes.Count(n => n.Selected))'
              OnPaneClick='_ => _log = "clic sur le fond"'
              OnEdgeClick='a => _log = "clic relation " + a.Edge.Id'>
        <FlowControls />
    </FlowView>
</div>

@code {
    // Deux façons de tenir le schéma, comme en WPF : un service en mode contrôlé, ou (?mvvm=1) des ViewModels.
    private SchemaStore? _store;
    private MvvmSchema? _mvvm;
    private ISchemaModel Store => (ISchemaModel?)_mvvm ?? _store!;

    private readonly NodeMapping _nodeMapping = new() { SelectedPath = "IsSelected", TypePath = "Type", WidthPath = "Width", HeightPath = "Height" };

    private readonly EdgeMapping _edgeMapping = new()
    {
        SourceHandlePath = "SourceColumn", TargetHandlePath = "TargetColumn", TypePath = "Type", SelectedPath = "IsSelected",
        LabelPath = "Label", DataPath = "Data", MarkerStartPath = "MarkerStart", MarkerEndPath = "MarkerEnd"
    };

    private Dictionary<string, object> DataParameters() => _mvvm is { } schema
        ? new()
        {
            ["NodesSource"] = schema.Tables, ["EdgesSource"] = schema.Relations,
            ["NodeMapping"] = _nodeMapping, ["EdgeMapping"] = _edgeMapping,
            ["NodeFactory"] = (Func<Node, object?>)schema.NodeFactory, ["EdgeFactory"] = (Func<Edge, object?>)schema.EdgeFactory,
            ["AutoConnect"] = false, ["OnConnect"] = EventCallback.Factory.Create<Connection>(this, schema.Connect),
            ["IsValidConnection"] = (Func<Connection, bool>)schema.CanConnect,
            ["OnBeforeDelete"] = (Func<DeleteRequest, Task<bool>>)(r => Task.FromResult(schema.MayDelete(r.Nodes, r.Edges)))
        }
        : new()
        {
            ["Nodes"] = _store!.Nodes, ["Edges"] = _store.Edges, ["AutoApplyChanges"] = false, ["AutoConnect"] = false,
            ["OnNodesChange"] = EventCallback.Factory.Create<IReadOnlyList<NodeChange>>(this, c => _store.Apply(c)),
            ["OnEdgesChange"] = EventCallback.Factory.Create<IReadOnlyList<EdgeChange>>(this, c => _store.Apply(c)),
            ["OnConnect"] = EventCallback.Factory.Create<Connection>(this, c => _store.Connect(c)),
            ["IsValidConnection"] = (Func<Connection, bool>)_store.CanConnect
        };

    private bool _refreshQueued;
    private readonly IReadOnlyDictionary<string, IEdgePathProvider> _edgeTypes =
        new Dictionary<string, IEdgePathProvider> { [Schemas.RelationType] = new RelationPath() };
    private Dictionary<string, RenderFragment<Node>>? _nodeTemplates;
    private FlowView? _flow;
    private bool _virtualize;
    private string _log = "", _menu = "", _selectionMenu = "", _json = "";
    // La suite des évènements reçus, pour en vérifier l'ordre (le même qu'en WPF).
    private readonly List<string> _events = [];
    private void Note(string what) => _events.Add(what);
    private Timer? _timer;
    private int _tick;

    protected override void OnInitialized()
    {
        _nodeTemplates = new Dictionary<string, RenderFragment<Node>> { [Schemas.TableType] = TableTemplate };
        if (Navigation.Uri.Contains("mvvm=1"))
        {
            _mvvm = new MvvmSchema(changes => _ = _flow!.ApplyNodeChanges(changes));
            _mvvm.Observe();
            _mvvm.Changed += Refresh;
        }
        else
        {
            _store = new SchemaStore();
            _store.Changed += Refresh;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Chargement asynchrone : le graphe s'affiche vide, les données arrivent ensuite.
        if (!firstRender) return;
        await Task.Delay(700);
        Store.Load(Schemas.Shop());
        await Task.Delay(500);
        if (_flow != null) await _flow.FitView();
    }

    // En MVVM, une rafale de notifications ne redessine l'application qu'une fois.
    private void Refresh()
    {
        if (_refreshQueued) return;
        _refreshQueued = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _refreshQueued = false;
            StateHasChanged();
        });
    }

    private static string Describe(NodeEventArgs a) =>
        a.TargetData.TryGetValue("column", out var column) ? $"{a.Node.Id}.{column}" : a.Node.Id;

    // Un autre document : l'historique de la vue ne doit pas ramener le précédent.
    private void Open(Schema schema)
    {
        Store.Load(schema);
        _flow!.ClearHistory();
    }

    private void Save() => _json = _mvvm == null
        ? Schemas.ToJson(Store.Nodes, Store.Edges, _flow!.Viewport)
        : _flow!.ToJson(n => ((TableViewModel)n.Data!).ToTable());

    private async Task Restore()
    {
        if (_mvvm == null) Open(Schemas.FromJson(_json));
        else await _flow!.LoadJson(_json); // les fabriques recréent les ViewModels
    }

    private void ToggleTicks()
    {
        if (_timer != null)
        {
            _timer.Dispose();
            _timer = null;
            return;
        }

        // La minuterie vit hors du contexte de rendu : le service est modifié sur celui du composant.
        _timer = new Timer(_ => _ = InvokeAsync(() => Store.Tick(++_tick % 2 == 0 ? "customers" : "orders")), null, 30, 30);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        if (_mvvm != null) _mvvm.Changed -= Refresh;
        if (_store != null) _store.Changed -= Refresh;
    }

    private RenderFragment<EdgeRenderContext> Label => context =>
        @<button class="relation-label nodrag nopan" data-relation="@context.Edge.Id"
                 @onclick='() => _log = "label " + context.Edge.Id' @onclick:stopPropagation @onpointerdown:stopPropagation>@context.Edge.Label</button>;

    private RenderFragment<Node> TableTemplate => node => @<TableNode Node="node" Store="Store" />;
}
