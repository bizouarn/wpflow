@* La page des applications témoins : l'éditeur de schéma (lot 2), la matrice des évènements (?matrix=geste, lot 3) ou les
   conditions hostiles (?hostile=mode, lot 4). *@
@inject NavigationManager Navigation

@if (Value("matrix") is { } gesture)
{
    <MatrixEditor GestureName="@gesture" />
}
else if (Value("hostile") is { } mode)
{
    <HostilePage Mode="@mode" />
}
else
{
    <SchemaEditor />
}

@code {
    private string? Value(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?').Split('&');
        var found = query.FirstOrDefault(p => p.StartsWith(key + "="));
        return found == null ? null : Uri.UnescapeDataString(found[(key.Length + 1)..]);
    }
}
